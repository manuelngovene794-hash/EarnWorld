# ========================================================
# EARNWORLD - VARIÁVEIS DE AMBIENTE REAIS PARA PRODUÇÃO & VERCEL
# ========================================================

# --------------------------------------------------------
# 1. GATEWAY DE SMS REAL (MOÇAMBIQUE +258 E INTERNACIONAL)
# Configure pelo menos UM dos fornecedores abaixo nas
# "Environment Variables" do seu projeto no painel do Vercel.
# --------------------------------------------------------

# OPÇÃO A: AFRICA'S TALKING (Altamente recomendado para Moçambique - Vodacom, Movitel, Tmcel)
# Crie conta em https://africastalking.com/
AFRICASTALKING_USERNAME="seu_usuario_africas_talking"
AFRICASTALKING_API_KEY="sua_chave_api_africas_talking"
AFRICASTALKING_SENDER_ID="EarnWorld"

# OPÇÃO B: TWILIO
# Crie conta em https://www.twilio.com/
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="seu_auth_token_twilio"
TWILIO_FROM="+1234567890"

# OPÇÃO C: INFOBIP (Líder em rotas SMS diretas em Moçambique)
# Crie conta em https://www.infobip.com/
INFOBIP_API_KEY="sua_chave_api_infobip"
INFOBIP_BASE_URL="https://xxxxxx.api.infobip.com"
INFOBIP_FROM="EarnWorld"

# OPÇÃO D: VONAGE / NEXMO
# Crie conta em https://www.vonage.com/
VONAGE_API_KEY="sua_api_key_vonage"
VONAGE_API_SECRET="seu_api_secret_vonage"
VONAGE_FROM="EarnWorld"

# OPÇÃO E: GATEWAY SMS HTTP GENÉRICO / WEBHOOK DE OPERADORA LOCAL
# Se possuir integração própria ou contrato direto com agregador de Moçambique:
SMS_GATEWAY_URL="https://seu-gateway-sms.com/api/send"
SMS_GATEWAY_API_KEY="seu_token_de_autorizacao"

# --------------------------------------------------------
# 2. SEGURANÇA E ASSINATURA DE OTP (HMAC SHA-256)
# Usado para assinar e validar criptograficamente os códigos OTP em ambiente serverless Vercel
# --------------------------------------------------------
OTP_SECRET="earnworld_segredo_criptografico_sms_2026_super_seguro"

# --------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (CLIENT-SIDE IDENTITY SERVICES)
# --------------------------------------------------------
VITE_GOOGLE_CLIENT_ID="160035757865-oc52j4k8r574pnsouid9vk2gkfgj6516.apps.googleusercontent.com"

# --------------------------------------------------------
# 4. MONETAG (RECEITA REAL SSP)
# --------------------------------------------------------
MONETAG_API_KEY="sua_chave_de_estatisticas_monetag_aqui"

# --------------------------------------------------------
# 5. CONFIGURAÇÃO DA APLICAÇÃO
# --------------------------------------------------------
APP_URL="https://seu-dominio.vercel.app"
VITE_APP_URL="https://seu-dominio.vercel.app"
NODE_ENV="production"
PORT=3000
